NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:3000
# Production example:
# CLIENT_ORIGIN=https://mermaid-md-to-pdf.vercel.app
MAX_MARKDOWN_BYTES=1048576
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_COUNT=20
MAX_DIAGRAM_COUNT=20
MAX_PDF_BYTES=15728640
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=20
PDF_RENDER_TIMEOUT_MS=30000
# Optional for local PDF rendering if Chrome is not auto-detected.
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
